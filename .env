# =============================================================================
#  dark-explorer — .env
#  Block explorer configuration.
#  Point these settings to any EVM-compatible blockchain node.
# =============================================================================

# -----------------------------------------------------------------------------
#  Target Blockchain — RPC Connection
# -----------------------------------------------------------------------------

# HTTP JSON-RPC endpoint of the target node
RPC_HTTP_URL=http://host.docker.internal:8545

# WebSocket JSON-RPC endpoint of the target node
RPC_WS_URL=ws://host.docker.internal:8546

# Chain ID of the target network
CHAIN_ID=2025

# Human-readable network name (shown in the Blockscout UI)
NETWORK_NAME=Dark Env

# Network sub-label (e.g. "Mainnet", "Testnet", "Private QBFT")
NETWORK_SUBNAME=Private QBFT

# -----------------------------------------------------------------------------
#  Block Explorer — Ports
# -----------------------------------------------------------------------------

# Port where the Blockscout UI will be accessible on the host
EXPLORER_PORT=25000

# -----------------------------------------------------------------------------
#  Images
# -----------------------------------------------------------------------------
BLOCKSCOUT_IMAGE=blockscout/blockscout:6.8.1
POSTGRES_IMAGE=postgres:15-alpine
REDIS_IMAGE=redis:7-alpine

# -----------------------------------------------------------------------------
#  Internal Database (Postgres)
# -----------------------------------------------------------------------------
POSTGRES_USER=blockscout
POSTGRES_PASSWORD=explorer_secret
POSTGRES_DB=blockscout
