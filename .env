# =============================================================================
#  dark-explorer — .env
#  Lite Block Explorer configuration.
#  Point these settings to any EVM-compatible blockchain node.
# =============================================================================

# HTTP JSON-RPC endpoint of the target node
RPC_HTTP_URL=http://host.docker.internal:8545

# Public path used when the Explorer is mounted below a reverse proxy.
EXPLORER_BASE_PATH=/explorer

# Port where the Explorer UI will be accessible on the host
EXPLORER_PORT=25000
